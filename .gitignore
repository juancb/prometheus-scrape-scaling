# Large vendored binaries / tarballs (kept on disk, not in git)
prometheus-3.12.0.linux-amd64.tar.gz
prometheus-3.12.0.linux-amd64/

# Built generator binary
metricgen/metricgen
bin/

# Benchmark output data (CSV/JSON/logs can be large) — keep dir, ignore contents
results/**/*.csv
results/**/*.log
results/**/*.json
results/**/prometheus.yml
results/**/.snap

# ...but DO keep the small distilled aggregate summaries (the scientific output).
# These are a handful of rows each; they are the data the analysis/plots consume.
!results/**/ratemax.csv
!results/**/scale.csv
!results/**/scale-summary.csv
!results/ramp__*.csv

# Transient TSDB data dirs
tsdb-data/
*.tsdb/
